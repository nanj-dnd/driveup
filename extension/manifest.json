{
  "manifest_version": 3,
  "name": "Driveup",
  "version": "1.0.0",
  "description": "Upload big files to Google Drive. Keeps going through sleep, wifi drops and restarts, and shows exactly what made it.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Driveup",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["identity", "notifications", "power", "storage"],
  "host_permissions": ["https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"]
}
